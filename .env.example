# ────────────────────────────────────────────────────────────────────────────
# DCE Global Country — variables de entorno del backend (packages/api).
# Copia este archivo a .env en la raíz del monorepo y ajusta los valores.
# ────────────────────────────────────────────────────────────────────────────

# Puerto HTTP del API
PORT=8080

# Secreto para firmar los JWT de sesión. ¡Cámbialo en producción!
JWT_SECRET=cambia-esto-en-produccion

# Duración de un Tick económico en segundos (GDD: 600 = 10 minutos).
# En desarrollo se usa 45 s para que los ciclos sean visibles.
TICK_SECONDS=600

# PostgreSQL (opcional): si se define, la persistencia usa PostgreSQL
# (aplicar antes sql/schema.sql + sql/seed.sql). Si no, se usa MemoryStore.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/dce_global_country
